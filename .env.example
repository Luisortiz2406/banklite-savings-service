NODE_ENV=development
PORT=3013
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://savings_svc:<DB_PASSWORD_SAVINGS>@localhost:5432/savings_db
JWT_SECRET=
# Clave interna PROPIA de savings-service (la acepta ledger-service).
INTERNAL_API_KEY=
LEDGER_SERVICE_URL=http://localhost:3006
ACCOUNT_SERVICE_URL=http://localhost:3002
# Solo demostración: botón "Simular vencimiento" de los CDT. Déjalo en false si no lo necesitas.
ENABLE_DEMO_MATURITY=false
