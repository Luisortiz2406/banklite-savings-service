NODE_ENV=development
PORT=3013
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://savings_svc:<DB_PASSWORD_SAVINGS>@localhost:5432/savings_db
JWT_SECRET=
# Clave interna PROPIA de savings-service (la acepta ledger-service).
INTERNAL_API_KEY=
# Quién puede pedir el resumen para cancelar la cuenta (GET /internal/savings/...): account-service.
INTERNAL_TRUSTED_KEYS=account:<clave-de-account>
LEDGER_SERVICE_URL=http://localhost:3006
ACCOUNT_SERVICE_URL=http://localhost:3002
# Eventos: escucha account.closed (cierra los bolsillos y metas vacíos del cliente).
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events
# Solo demostración: botón "Simular vencimiento" de los CDT. Déjalo en false si no lo necesitas.
ENABLE_DEMO_MATURITY=false

# Opcionales (estos son los valores por defecto).
# Reintentos de las lecturas entre servicios (GET); las escrituras no se reintentan.
HTTP_READ_RETRIES=1
# Reintentos de un evento que falla antes de mandarlo a la DLQ (<cola>.dlq).
EVENT_MAX_RETRIES=5
EVENT_RETRY_DELAY_MS=10000
